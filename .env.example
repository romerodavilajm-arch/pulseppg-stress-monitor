# Copiar como .env junto a compose.yaml para cambiar valores; todo es opcional.

# Credenciales de PostgreSQL (solo se aplican al crear el volumen pgdata; para
# cambiarlas después: docker compose down -v, que borra las sesiones).
POSTGRES_DB=pulseppg
POSTGRES_USER=pulseppg
POSTGRES_PASSWORD=pulseppg

# Duración de la captura del simulador, en segundos. 300 = 5 min como la Pi
# real; para probar rápido, 60 (el modelo necesita al menos 30).
SIM_DURATION_SEC=300

# Sesiones que conserva la base (las más viejas se borran al terminar otra).
MAX_SESSIONS=10
